NODE_ENV=development
PORT=4000
# Reverse proxy arkasında çalışıyorsa proxy hop sayısı (örn. 1). Doğrudan açık ise 0.
TRUST_PROXY=0

DATABASE_URL=postgres://seo:seo_password@localhost:5432/seo_checker
DATABASE_SSL=false
# Prisma migrate için doğrudan (pooler olmayan) bağlantı. Neon: host adındaki "-pooler" olmadan.
# Boşsa DATABASE_URL kullanılır.
DIRECT_DATABASE_URL=
# Opsiyonel: `migrate:dev` için shadow DB (Neon'da ayrı bir branch verilebilir)
SHADOW_DATABASE_URL=

# İstemcinin çalıştığı origin (virgülle birden fazla verilebilir)
CLIENT_ORIGIN=http://localhost:5173

# `npm run gen:secrets` ile üretin. Asla repoya koymayın.
JWT_ACCESS_SECRET=
# 32 byte = 64 hex karakter. Google tokenlarını AES-256-GCM ile şifreler.
ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Production'da true olmalı (HTTPS zorunlu)
COOKIE_SECURE=false

# İlk kullanıcı her zaman kayıt olabilir (admin olur). Sonrası için:
ALLOW_REGISTRATION=false

# Google Cloud Console > OAuth Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback

# Opsiyonel; yoksa düşük kotalı anonim istek atılır
PAGESPEED_API_KEY=

# Search Console senkronizasyon penceresi (gün, max 480)
GSC_SYNC_DAYS=90
# Site sağlığı taramasında maksimum sayfa
AUDIT_MAX_PAGES=100

# Lokasyon bazlı Google sıralamaları (opsiyonel, ücretli): https://app.dataforseo.com/api-access
# Boşsa "Sıralamalar" sekmesi kurulum talimatı gösterir, hiçbir istek atılmaz.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Ülke başına çekilecek en fazla sıralanan kelime (10-1000)
RANK_KEYWORDS_LIMIT=1000
# Kelime kontrolünde taranacak Google sonucu sayısı (10'luk sayfalar halinde ücretlendirilir)
RANK_CHECK_DEPTH=100
# Bir güncellemede sorgulanacak en fazla ülke
RANK_MAX_LOCATIONS=60

# Canlı Google sıralama doğrulaması (opsiyonel, ücretsiz plan ayda ~250 arama): https://serpapi.com/manage-api-key
SERPAPI_KEY=
# Doğrulamada taranacak Google sonuç sayfası (her sayfa 10 sonuç = 1 arama hakkı)
SERP_CHECK_PAGES=2

# Backlink keşfi (ücretsiz): Bing Webmaster Tools > Ayarlar > API Erişimi > API Anahtarı
BING_WEBMASTER_API_KEY=
# Bir taramada doğrulanacak en fazla bağlantı (kaynak sayfa ziyaret edilir)
BACKLINK_VERIFY_LIMIT=1500

# Otomatik izleme: günlük Search Console senkronu, haftalık tarama/backlink/indeks denetimi, günlük SSL kontrolü
SCHEDULER_ENABLED=true
# Haftalık indeks denetiminde en fazla sayfa (Google kotası: mülk başına günde 2000)
INDEX_INSPECT_LIMIT=200
# Opsiyonel Telegram bildirimi: @BotFather ile bot oluşturun, sohbet kimliği için @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alan adı otoritesi (ücretsiz, ayda 30.000 alan adı): keywordseverywhere.com/account/openpagerank
OPEN_PAGERANK_API_KEY=

# Sayfa değişiklik izleme: ana sayfa + en çok trafik alan sayfalar bu aralıkla kontrol edilir
# (noindex, hata kodu, canonical, title/H1 değişikliği -> anında uyarı)
MONITOR_PAGES=25
MONITOR_INTERVAL_HOURS=6
# Rakip taramasında en fazla sayfa (rakipler haftalık yeniden taranır; yeni sayfa/güncelleme uyarısı)
COMPETITOR_MAX_PAGES=100

# Core Web Vitals geçmişi (CrUX History API, ücretsiz). Google Cloud Console → API'ler → "Chrome UX Report API"yi etkinleştirin,
# Kimlik bilgileri → API anahtarı oluşturun. Boşsa PAGESPEED_API_KEY denenir.
CRUX_API_KEY=
# SERP özellikleri / AI Overview takibi (SERPAPI_KEY gerekir). Ücretsiz plan: ayda 250 arama.
# Kelime başına haftada 1 arama (+AI Overview ayrı sayfadaysa 1). Kota rezervin altına düşerse kontrol durur.
SERP_TRACK_LIMIT=20
SERP_TRACK_INTERVAL_DAYS=7
SERP_QUOTA_RESERVE=20
SERP_AI_OVERVIEW_FETCH=true
# İçerik brief'inde Google otomatik tamamlama önerileri (ücretsiz)
AUTOCOMPLETE_ENABLED=true
