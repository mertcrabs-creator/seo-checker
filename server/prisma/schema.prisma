  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([domainId, createdAt(sort: Desc)], map: "log_analyses_domain_idx")
  @@map("log_analyses")
}

// ---------------------------------------------------------------- İçerik ve rakip istihbaratı
