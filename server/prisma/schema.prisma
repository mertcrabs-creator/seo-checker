/// Rakip site taraması (ücretli sağlayıcı olmadan sayfa içi karşılaştırma)
model Competitor {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  domainId     String    @map("domain_id") @db.Uuid
  hostname     String
  status       String    @default("queued")
  error        String?
  pagesCrawled Int       @default(0) @map("pages_crawled")
  score        Int?
  siteInfo     Json      @default("{}") @map("site_info") @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)

  domain   Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pages       CompetitorPage[]
  keywords    CompetitorKeyword[]
  sitemapUrls CompetitorSitemapUrl[]
  changes     CompetitorChange[]

  @@unique([domainId, hostname])
  @@map("competitors")
}

model CompetitorPage {
  competitorId    String   @map("competitor_id") @db.Uuid
  url             String
  statusCode      Int?     @map("status_code")
  title           String?
  h1              String?
  metaDescription String?  @map("meta_description")
  wordCount       Int?     @map("word_count")
  primaryKeyword  String?  @map("primary_keyword")
  schemaTypes     String[] @default([]) @map("schema_types")
  onpageScore     Int?     @map("onpage_score")
  depth           Int      @default(0)
  inlinks         Int      @default(0)
  lang            String?
  outline         Json?    @db.JsonB
  publishedAt     DateTime? @map("published_at") @db.Date
  modifiedAt      DateTime? @map("modified_at") @db.Date
  schemaReport    Json?    @map("schema_report") @db.JsonB

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([competitorId, url])
  @@map("competitor_pages")
}

model CompetitorKeyword {
  competitorId String  @map("competitor_id") @db.Uuid
  url          String
  keyword      String
  score        Float   @db.Real
  inTitle      Boolean @map("in_title")
  inH1         Boolean @map("in_h1")

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([competitorId, url, keyword])
  @@index([competitorId, keyword], map: "competitor_keywords_keyword_idx")
  @@map("competitor_keywords")
}

/// Sunucu log analizi özeti (log tarayıcıda ayrıştırılır; sadece bot istatistikleri gönderilir)
